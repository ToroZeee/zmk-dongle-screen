/ {
   chosen {
      zephyr,display = &st7789;
   };

   pwmleds {
      compatible = "pwm-leds";
      disp_bl: pwm_led_1 {
          pwms = <&pwm1 0 PWM_MSEC(1) PWM_POLARITY_NORMAL>;
      };
   };

   aliases {
      backlight = &disp_bl;
   };
};

&pinctrl {
   /* バックライト制御ピン: D18 (P0.18) */
   pwm1_default: pwm1_default {
      group1 {
         psels = <NRF_PSEL(PWM_OUT0, 0, 18)>;
      };
   };

   pwm1_sleep: pwm1_sleep {
      group1 {
         psels = <NRF_PSEL(PWM_OUT0, 0, 18)>;
         low-power-enable;
      };
   };
};

/* ディスプレイ用 SPI バス (D8=SCK, D10=MOSI, D2=CS) */
&xiao_spi {
   status = "okay";
   cs-gpios = <&xiao_d 2 GPIO_ACTIVE_LOW>;
};

/ {
   mipi_dbi {
       compatible = "zephyr,mipi-dbi-spi";
       spi-dev = <&xiao_spi>;
       dc-gpios = <&xiao_d 3 GPIO_ACTIVE_HIGH>;    /* D3 */
       reset-gpios = <&gpio0 9 GPIO_ACTIVE_LOW>;  /* D17 (P0.09) */
       write-only;
       #address-cells = <1>;
       #size-cells = <0>;

       st7789: st7789v@0 {
           compatible = "sitronix,st7789v";
           mipi-max-frequency = <10000000>;
           mipi-mode = "MIPI_DBI_MODE_SPI_4WIRE";
           reg = <0>;
           width = <240>;
           height = <135>;
           x-offset = <40>;
           y-offset = <53>;
           vcom = <0x19>;
           gctrl = <0x35>;
           vrhs = <0x12>;
           vdvs = <0x20>;
           mdac = <0x60>;
           gamma = <0x01>;
           colmod = <0x05>;
           lcm = <0x2c>;
           porch-param = [ 0c 0c 00 33 33  ];
           cmd2en-param = [ 5a 69 02 01  ];
           pwctrl1-param = [ a4 a1  ];
           pvgam-param = [ D0 04 0D 11 13 2B 3F 54 4C 18 0D 0B 1F 23  ];
           nvgam-param = [ D0 04 0C 11 13 2C 3F 44 51 2F 1F 1F 20 23  ];
           ram-param = [ 00 F0  ];
           rgb-param = [ CD 08 14  ];
       };
   };
};

/* 環境光センサーは未搭載のため無効化 */
&i2c1 {
   status = "disabled";
};

&pwm1 {
  status = "okay";
  pinctrl-0 = <&pwm1_default>;
  pinctrl-1 = <&pwm1_sleep>;
  pinctrl-names = "default", "sleep";
};